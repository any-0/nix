{
  "layer": "top",
  "position": "top",
  "height": 16,
  "spacing": 8,
  "margin-left": 8,
  "margin-right": 8,
  "modules-right": ["custom/time", "custom/date"],
  "modules-center": ["niri/workspaces"],
  "modules-left": ["network", "pulseaudio", "custom/bt-battery"],

  "custom/date": {
    "exec": "date '+%d/%m/%Y'",
    "interval": 60
  },
  "custom/time": {
    "exec": "date '+%H:%M'",
    "interval": 60
  },

  "niri/workspaces": {
    "format": "{icon}",
    "all-outputs": false,
    "tooltip": false,
    "format-icons": {
      "focused": "■",
      "default": "●"
    }
  },

  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰖁 muted",
    "scroll-step": 2,
    "tooltip": false,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "network": {
    "format-wifi": "󰤨 Wifi",
    "format-ethernet": "󰒍 Eth",
    "format-disconnected": "󰤭",
    "tooltip": false
  },

  "custom/bt-battery": {
    "exec": "~/.config/waybar/bt-battery.sh",
    "interval": 30,
    "signal": 1,
    "format": "󰂯 {text}%",
    "format-icons": false,
    "tooltip": false,
    "escape": false,
    "return-type": "json",
    "on-click": "~/.config/waybar/bluetooth-toggle.sh"
  }
}
