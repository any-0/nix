#!/usr/bin/env bash
set -euo pipefail

STORE_DIR="$HOME/nix/gopass/store"
ARCHIVE="$HOME/nix/gopass/store.tar.gpg"
RECIPIENT="0xA9361218DE172404"

if [[ ! -d "$STORE_DIR" ]]; then
  echo "gopass store not found at $STORE_DIR" >&2
  exit 1
fi

tar -cf - -C "$HOME/nix/gopass" store | gpg --encrypt --recipient "$RECIPIENT" --output "$ARCHIVE" --yes
echo "Packed gopass store → $ARCHIVE"
