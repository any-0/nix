+#[cfg(test)]
+mod subpixel_tests {
+    use super::*;
+
+    #[test]
+    fn output_subpixel_config_and_region_inheritance() {
+        for (name, expected) in [
+            ("unknown", Subpixel::Unknown),
+            ("none", Subpixel::None),
+            ("rgb", Subpixel::HorizontalRgb),
+            ("bgr", Subpixel::HorizontalBgr),
+            ("vrgb", Subpixel::VerticalRgb),
+            ("vbgr", Subpixel::VerticalBgr),
+        ] {
+            let config = Config::parse_mem(&format!(
+                r#"
+                output "DP-1" {{ subpixel "{name}"; }}
+                output "region" {{
+                    create-virtual
+                    mode "1440x1280@60"
+                    region-of "DP-1" x=0 y=640
+                }}
+                output "explicit" {{ create-virtual; subpixel "{name}"; }}
+            "#
+            ))
+            .unwrap();
+            for output in ["region", "explicit"] {
+                let built = build_headless_virtual_output(
+                    &mut 0,
+                    1440,
+                    1280,
+                    60_000,
+                    Some(output.into()),
+                    &config,
+                );
+                assert_eq!(built.output.physical_properties().subpixel, expected);
+            }
+        }
+        assert!(Config::parse_mem(r#"output "DP-1" { subpixel "rbga"; }"#).is_err());
+    }
+
+    #[test]
+    fn ordinary_virtual_output_does_not_assume_a_panel_layout() {
+        let built = build_headless_virtual_output(
+            &mut 0,
+            1920,
+            1080,
+            60_000,
+            Some("sunshine".into()),
+            &Config::default(),
+        );
+        assert_eq!(
+            built.output.physical_properties().subpixel,
+            Subpixel::Unknown
+        );
+    }
+}
