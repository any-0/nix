+use niri_config::Config;
+use smithay::utils::Point;
+
+use super::*;
+
+fn regions() -> Fixture {
+    let config = Config::parse_mem(
+        r#"
+        output "headless-1" { position x=0 y=0; }
+        output "portrait-top" {
+            create-virtual
+            mode "1440x843@60"
+            region-of "headless-1" x=0 y=30
+        }
+        output "portrait-bottom" {
+            create-virtual
+            mode "1440x1687@60"
+            region-of "headless-1" x=0 y=873
+        }
+        output "portrait-center" {
+            off
+            create-virtual
+            mode "1440x843@60"
+            region-of "headless-1" x=0 y=873
+        }
+        layout { gaps 0; default-column-width { proportion 1.0; }; }
+    "#,
+    )
+    .unwrap();
+    let mut f = Fixture::with_config(config);
+    f.add_output(1, (1440, 2560));
+    let state = f.niri_state();
+    state.backend.on_output_config_changed(&mut state.niri);
+    f
+}
+
+#[test]
+fn regions_keep_host_position_and_route_pointer() {
+    let mut f = regions();
+    for (point, expected) in [
+        ((700., 15.), "headless-1"),
+        ((700., 30.), "portrait-top"),
+        ((700., 872.), "portrait-top"),
+        ((700., 873.), "portrait-bottom"),
+        ((700., 2559.), "portrait-bottom"),
+    ] {
+        let (output, local) = f.niri().output_under(Point::from(point)).unwrap();
+        assert_eq!(output.name(), expected);
+        assert!(local.x >= 0. && local.y >= 0.);
+    }
+    assert!(f.niri().output_under(Point::from((1440., 100.))).is_none());
+}
+
+#[test]
+fn region_new_window_gets_region_size_before_mapping() {
+    let mut f = regions();
+    let bottom = f
+        .niri()
+        .global_space
+        .outputs()
+        .find(|o| o.name() == "portrait-bottom")
+        .unwrap()
+        .clone();
+    f.niri().layout.focus_output(&bottom);
+    let id = f.add_client();
+    let window = f.client(id).create_window();
+    let surface = window.surface.clone();
+    window.commit();
+    f.roundtrip(id);
+    let configures = f.client(id).window(&surface).format_recent_configures();
+    assert!(configures.contains("1440 × 1687"), "{configures}");
+    let window = f.client(id).window(&surface);
+    window.attach_new_buffer();
+    window.ack_last_and_commit();
+    f.double_roundtrip(id);
+    let window = f.client(id).window(&surface);
+    window.set_fullscreen(None);
+    window.commit();
+    f.double_roundtrip(id);
+    let configures = f.client(id).window(&surface).format_recent_configures();
+    assert!(configures.contains("1440 × 1687"), "{configures}");
+    assert!(configures.contains("Fullscreen"), "{configures}");
+    // Even clients requesting the physical monitor must remain in their region.
+    let host_resource = f
+        .client(id)
+        .state
+        .outputs
+        .iter()
+        .find(|(_, name)| name.as_str() == "headless-1")
+        .unwrap()
+        .0
+        .clone();
+    let window = f.client(id).window(&surface);
+    window.ack_last_and_commit();
+    window.set_fullscreen(Some(&host_resource));
+    window.commit();
+    f.double_roundtrip(id);
+    let configures = f.client(id).window(&surface).format_recent_configures();
+    assert!(configures.contains("1440 × 1687"), "{configures}");
+}
+
+#[test]
+fn removing_host_removes_its_regions() {
+    let mut f = regions();
+    let host = f
+        .niri()
+        .global_space
+        .outputs()
+        .find(|o| o.name() == "headless-1")
+        .unwrap()
+        .clone();
+    f.niri().remove_output(&host);
+    assert_eq!(f.niri().global_space.outputs().count(), 0);
+}
+
+#[test]
+fn region_config_requires_virtual_output_and_mode() {
+    assert!(Config::parse_mem("output \"bad\" { region-of \"host\"; }").is_err());
+    assert!(Config::parse_mem(
+        "output \"bad\" { create-virtual; mode \"100x100\"; region-of \"bad\"; }"
+    )
+    .is_err());
+}
+
+#[test]
+fn center_region_sizes_new_windows_even_when_host_is_focused() {
+    let mut f = regions();
+    f.niri_state()
+        .modify_output_config("portrait-top", |c| c.off = true);
+    f.niri_state()
+        .modify_output_config("portrait-bottom", |c| c.off = true);
+    f.niri_state()
+        .modify_output_config("portrait-center", |c| c.off = false);
+    f.niri_state().reload_output_config();
+    let host = f
+        .niri()
+        .global_space
+        .outputs()
+        .find(|o| o.name() == "headless-1")
+        .unwrap()
+        .clone();
+    f.niri().layout.focus_output(&host);
+    assert_eq!(
+        f.niri().output_under((700., 500.).into()).unwrap().0.name(),
+        "headless-1"
+    );
+    assert_eq!(
+        f.niri()
+            .output_under((700., 1000.).into())
+            .unwrap()
+            .0
+            .name(),
+        "portrait-center"
+    );
+    let id = f.add_client();
+    let window = f.client(id).create_window();
+    let surface = window.surface.clone();
+    window.commit();
+    f.roundtrip(id);
+    let configures = f.client(id).window(&surface).format_recent_configures();
+    assert!(configures.contains("1440 × 843"), "{configures}");
+}
+
+#[test]
+fn region_directional_focus_skips_presentation_host() {
+    let mut f = regions();
+    let top = f
+        .niri()
+        .global_space
+        .outputs()
+        .find(|o| o.name() == "portrait-top")
+        .unwrap()
+        .clone();
+    let bottom = f
+        .niri()
+        .global_space
+        .outputs()
+        .find(|o| o.name() == "portrait-bottom")
+        .unwrap()
+        .clone();
+    assert_eq!(f.niri().output_down_of(&top), Some(bottom.clone()));
+    assert_eq!(f.niri().output_up_of(&bottom), Some(top));
+}
