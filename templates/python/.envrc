export PROJECT_ROOT="$PWD"

use flake ./.dev

export PYTHONPYCACHEPREFIX="$PROJECT_ROOT/.pycache"

export MPLCONFIGDIR="$PROJECT_ROOT/.direnv/matplotlib"
mkdir -p "$MPLCONFIGDIR"
if [ ! -f "$MPLCONFIGDIR/matplotlibrc" ]; then
  printf 'backend: TkAgg\nbackend_fallback: False\n' > "$MPLCONFIGDIR/matplotlibrc"
fi

# Python packages come from nix: add them in .dev/flake.nix (python312.withPackages).
# Only if a package is missing from nixpkgs, uncomment layer_venv below to layer a
# pip venv on top of the nix python (--system-site-packages keeps nix packages visible).
layer_venv() {
  VENV_DIR="$PROJECT_ROOT/.venv"
  if [ -f "$VENV_DIR/bin/activate" ]; then
    VENV_PATH="$(sed -n 's/^VIRTUAL_ENV="\([^"]*\)"$/\1/p' "$VENV_DIR/bin/activate")"
    if [ "$VENV_PATH" != "$VENV_DIR" ]; then
      rm -rf "$VENV_DIR"
    fi
  fi
  if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR" --system-site-packages
  fi
  # shellcheck disable=SC1091
  source "$VENV_DIR/bin/activate"
}
# layer_venv

export RUN_CMD="python3 main.py"
export FORMAT_CMD='ruff --verbose format .'
