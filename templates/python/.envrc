export PROJECT_ROOT="$PWD"

use flake ./.dev

VENV_DIR="$PROJECT_ROOT/.venv"
if [ -f "$VENV_DIR/bin/activate" ]; then
  VENV_PATH="$(sed -n 's/^VIRTUAL_ENV="\([^"]*\)"$/\1/p' "$VENV_DIR/bin/activate")"
  if [ "$VENV_PATH" != "$VENV_DIR" ]; then
    rm -rf "$VENV_DIR"
  fi
fi

if [ ! -d "$VENV_DIR" ]; then
  python3 -m venv "$VENV_DIR" --system-site-packages
fi

source "$VENV_DIR/bin/activate"

export PYTHONPYCACHEPREFIX="$PROJECT_ROOT/.pycache"
export MPLCONFIGDIR="$VENV_DIR/matplotlib"
mkdir -p "$MPLCONFIGDIR"
if [ ! -f "$MPLCONFIGDIR/matplotlibrc" ]; then
  printf 'backend: TkAgg\nbackend_fallback: False\n' > "$MPLCONFIGDIR/matplotlibrc"
fi

export RUN_CMD="python3 main.py"
export FORMAT_CMD='ruff --verbose format .'
