#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: open <file>" >&2
  exit 1
fi

case "$(uname -s)" in
  Darwin)
    nohup /usr/bin/open "$1" >/dev/null 2>&1 &
    ;;
  Linux)
    nohup xdg-open "$1" >/dev/null 2>&1 &
    ;;
  *)
    echo "unsupported platform: $(uname -s)" >&2
    exit 1
    ;;
esac
