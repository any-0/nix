if [[ -t 0 ]]; then
  echo "yank: expected input on stdin" >&2
  echo "usage: <command> | yank" >&2
  return 1 2>/dev/null || exit 1
fi

tmp="$(mktemp)" || {
  echo "yank: failed to create temp file" >&2
  return 1 2>/dev/null || exit 1
}

cleanup() {
  rm -f "$tmp"
}
trap cleanup EXIT

cat >"$tmp"

if command -v wl-copy >/dev/null 2>&1; then
  if wl-copy <"$tmp"; then
    return 0 2>/dev/null || exit 0
  fi
fi

if command -v wl-clip >/dev/null 2>&1; then
  if wl-clip <"$tmp"; then
    return 0 2>/dev/null || exit 0
  fi
fi

if command -v clip.exe >/dev/null 2>&1; then
  if clip.exe <"$tmp"; then
    return 0 2>/dev/null || exit 0
  fi
fi

echo "yank: no usable clipboard command found (tried wl-copy, wl-clip, clip.exe)" >&2
return 127 2>/dev/null || exit 127
