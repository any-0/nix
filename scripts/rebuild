#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "rebuild is only supported on Linux" >&2
  exit 1
fi

HOSTNAME=$(hostnamectl --static 2>/dev/null || hostname)
MODE="${1:-switch}"

case "${MODE}" in
  switch|boot|test|build)
    ;;
  *)
    echo "usage: $(basename "$0") [switch|boot|test|build]" >&2
    exit 2
    ;;
esac

echo "Rebuilding host '${HOSTNAME}' from '${REPO_DIR}' with mode '${MODE}'..."
sudo nixos-rebuild "${MODE}" --flake "path:${REPO_DIR}#${HOSTNAME}"

echo "Rebuild complete!"
