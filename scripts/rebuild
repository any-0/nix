#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

pushd "$REPO_DIR" > /dev/null
trap 'popd > /dev/null || true' EXIT

if ! command -v git >/dev/null 2>&1; then
  echo "git not found in PATH"
  exit 1
fi

echo "Current working tree:"
git status --short

has_unstaged=0
if ! git diff --quiet || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
  has_unstaged=1
fi

if [[ "$has_unstaged" -eq 1 ]]; then
  read -r -p "Stage all unstaged/untracked changes before rebuild? [y/N] " stage_all
  case "$stage_all" in
    y|Y|yes|YES)
      git add -A
      ;;
    *)
      echo "Leaving working tree unchanged. Use pre-staged changes only."
      ;;
  esac
fi

has_staged=1
if git diff --cached --quiet; then
  has_staged=0
  echo "No staged changes to commit. Proceeding with rebuild without creating a git commit."
fi

HOSTNAME=$(hostnamectl --static 2>/dev/null || hostname)

echo "Rebuilding host '${HOSTNAME}' from '${REPO_DIR}'..."
sudo nixos-rebuild switch --flake "${REPO_DIR}#${HOSTNAME}"

gen=$(nixos-rebuild list-generations | grep -m1 ' True$')
if [[ "$has_staged" -eq 1 ]]; then
  git commit -m "Nix rebuild #$gen"
else
  echo "Skipped git commit for generation #$gen because nothing is staged."
fi

echo "Rebuild complete!"
