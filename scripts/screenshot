#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "screenshot is only supported on Linux" >&2
  exit 1
fi

dir="${HOME}/Pictures/Screenshots"
timestamp="$(date +%F_%H-%M-%S)"
path="${dir}/${timestamp}.png"

mkdir -p "$dir"

region="$(slurp)"
[[ -n "$region" ]]

grim -g "$region" "$path"
wl-copy --foreground <"$path" &
notify-send "Screenshot saved" "$path"
