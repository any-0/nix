#!/usr/bin/env python3
import json, subprocess, os, sys, re, shutil
from collections import OrderedDict

if sys.platform != "linux":
    print("drives is only supported on Linux", file=sys.stderr)
    sys.exit(1)

# ── ANSI ──────────────────────────────────────────────────────────────────────

class C:
    RESET   = "\033[0m"
    BOLD    = "\033[1m"
    DIM     = "\033[2m"
    RED     = "\033[31m"
    GREEN   = "\033[32m"
    YELLOW  = "\033[33m"
    CYAN    = "\033[36m"
    BRED    = "\033[1;31m"
    BGREEN  = "\033[1;32m"
    BYELLOW = "\033[1;33m"
    BBLUE   = "\033[1;34m"

    @staticmethod
    def w(color, text):
        return f"{color}{text}{C.RESET}"

    @staticmethod
    def bar(pct, width=10):
        filled = round(pct * width / 100)
        bc = C.RED if pct >= 90 else C.YELLOW if pct >= 70 else C.GREEN
        return C.w(bc, "\u2588" * filled) + C.w(C.DIM, "\u2591" * (width - filled))

    @staticmethod
    def pct(pct):
        pc = C.BRED if pct >= 90 else C.BYELLOW if pct >= 70 else C.GREEN
        return C.w(pc, f"{pct:>3}%")

    @staticmethod
    def health(passed):
        return C.w(C.BGREEN if passed else C.BRED, "PASSED" if passed else "FAILED")

    @staticmethod
    def temp(val):
        tc = C.BRED if val >= 60 else C.BYELLOW if val >= 45 else C.GREEN
        return C.w(tc, f"{val}\u00b0C")

    @staticmethod
    def worn(val):
        wc = C.BRED if val >= 75 else C.BYELLOW if val >= 25 else C.GREEN
        return C.w(wc, f"{val}% worn")


# ── Utilities ─────────────────────────────────────────────────────────────────

def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return ""

def human_size(b):
    if b == 0:
        return "0 B"
    for unit in ["B", "KiB", "MiB", "GiB", "TiB", "PiB"]:
        if abs(b) < 1024:
            return f"{int(b)} B" if unit == "B" else f"{b:.1f} {unit}"
        b /= 1024
    return f"{b:.1f} PiB"

def get_usage(mp):
    if not mp:
        return None
    out = run(["df", "--output=pcent", mp])
    for line in out.strip().splitlines()[1:]:
        try:
            return int(line.strip().rstrip("%"))
        except ValueError:
            pass
    return None

def get_total_bytes(mp):
    out = run(["df", "-B1", "--output=size", mp])
    for line in out.strip().splitlines()[1:]:
        try:
            return int(line.strip())
        except ValueError:
            pass
    return 0

def disk_type_str(tran, rota):
    if tran == "nvme":  return "NVMe"
    if tran == "usb":   return "USB"
    if tran in ("sata", "ata"):
        return "SATA HDD" if rota else "SATA"
    return "HDD" if rota else "SSD"

def get_smart(dev):
    if os.geteuid() != 0:
        return None
    out = run(["smartctl", "-ja", f"/dev/{dev}"])
    if not out:
        return None
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        return None
    r = {}
    v = data.get("smart_status", {}).get("passed")
    if v is not None: r["passed"] = v
    v = data.get("temperature", {}).get("current")
    if v is not None: r["temp"] = v
    v = data.get("power_on_time", {}).get("hours")
    if v is not None: r["hours"] = v
    v = data.get("endurance_used", {}).get("current_percent")
    if v is not None: r["worn"] = v
    return r or None

def parse_net_server(dev, fstype):
    fs = fstype.lower()
    if fs == "cifs":
        m = re.match(r'^//([^/]+)(/.*)$', dev)
        if m: return m.group(1), m.group(2)
    elif fs in ("nfs", "nfs4"):
        m = re.match(r'^([^:]+):(.+)$', dev)
        if m: return m.group(1), m.group(2)
    elif "sshfs" in fs or "rclone" in fs:
        m = re.match(r'^(?:[^@]+@)?([^:]+):(.+)$', dev)
        if m: return m.group(1), m.group(2)
    return dev, ""

def max_len(strings):
    return max((len(s) for s in strings), default=0)


# ── Data collection ───────────────────────────────────────────────────────────

has_smartctl = shutil.which("smartctl") is not None

lsblk_out = run(["lsblk", "-Jb", "-o",
    "NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT,MODEL,SERIAL,TRAN,ROTA,RO,STATE"])
if not lsblk_out:
    print("(lsblk not available)")
    sys.exit(0)

devices = json.loads(lsblk_out).get("blockdevices", [])

# -- Disks: collect all info in one pass --

disks = []
for d in devices:
    if d.get("type") != "disk":
        continue
    name = d.get("name") or ""
    if name.startswith(("zram", "loop")):
        continue

    model = (d.get("model") or "").strip() or name
    tran = d.get("tran") or ""
    rota = bool(d.get("rota"))
    dtype = disk_type_str(tran, rota)
    size_s = human_size(d.get("size") or 0)
    smart = get_smart(name) if has_smartctl else None

    mounted = []
    unmounted_count = 0
    for ch in d.get("children", []):
        if ch.get("mountpoint"):
            mp = ch["mountpoint"]
            mounted.append({
                "mp": mp,
                "size": human_size(ch.get("size") or 0),
                "fs": ch.get("fstype") or "",
                "pct": get_usage(mp),
            })
        else:
            unmounted_count += 1
    mounted.sort(key=lambda c: c["mp"])

    disks.append({
        "name": name, "model": model, "dtype": dtype, "size": size_s,
        "smart": smart, "mounted": mounted, "unmounted": unmounted_count,
    })

# -- SMART: pre-format fields and compute column widths --

smart_parts = {}
for disk in disks:
    s = disk["smart"]
    if not s:
        continue
    parts = []
    if "passed" in s:
        h = "PASSED" if s["passed"] else "FAILED"
        parts.append((h, C.health(s["passed"])))
    if "temp" in s:
        t = f"{s['temp']}\u00b0C"
        parts.append((t, C.temp(s["temp"])))
    if "hours" in s:
        h = f"{s['hours']:,} hrs"
        parts.append((h, C.w(C.DIM, h)))
    if "worn" in s:
        w = f"{s['worn']}% worn"
        parts.append((w, C.worn(s["worn"])))
    smart_parts[disk["name"]] = parts

smart_col_w = []
for parts in smart_parts.values():
    for i, (plain, _) in enumerate(parts):
        while len(smart_col_w) <= i:
            smart_col_w.append(0)
        smart_col_w[i] = max(smart_col_w[i], len(plain))

# -- Network mounts: group by server --

net_fs = {"cifs", "nfs", "nfs4", "fuse.sshfs", "fuse.rclone"}
net_servers = OrderedDict()
try:
    with open("/proc/mounts") as f:
        for line in f:
            parts = line.split()
            if len(parts) < 3 or parts[2].lower() not in net_fs:
                continue
            dev, mp_raw, fstype = parts[0], parts[1], parts[2]
            mp = mp_raw.encode("raw_unicode_escape").decode("unicode_escape")
            server, share = parse_net_server(dev, fstype)
            net_servers.setdefault(server, []).append({
                "share": share, "mp": mp, "fs": fstype,
                "total": get_total_bytes(mp), "pct": get_usage(mp),
            })
except FileNotFoundError:
    pass

for mounts in net_servers.values():
    mounts.sort(key=lambda m: m["mp"])


# ── Column widths ─────────────────────────────────────────────────────────────
# Headers and children share three columns: name, size, type/fs.
# Headers start 3 chars earlier than children (no tree prefix), so header
# names are padded +3 to keep the size column aligned.

all_names = (
    [d["model"] for d in disks]
    + [c["mp"] for d in disks for c in d["mounted"]]
    + list(net_servers.keys())
    + [f"{m['share']} \u2192 {m['mp']}" for ms in net_servers.values() for m in ms]
)
all_sizes = (
    [d["size"] for d in disks]
    + [c["size"] for d in disks for c in d["mounted"]]
    + [human_size(sum(m["total"] for m in ms)) for ms in net_servers.values()]
    + [human_size(m["total"]) for ms in net_servers.values() for m in ms]
)
all_types = (
    [d["dtype"] for d in disks]
    + [c["fs"] for d in disks for c in d["mounted"]]
    + [m["fs"].upper() for ms in net_servers.values() for m in ms]
)

labels = [f"Disk ({d['name']}):" for d in disks]
if net_servers:
    labels.append("Network:")

label_w      = max_len(labels) + 1
child_name_w = max_len(all_names)
header_name_w = child_name_w + 3  # compensate for tree prefix offset
col_size_w   = max_len(all_sizes)
col_type_w   = max_len(all_types)

indent = " " * label_w

# Dynamic bar width: fill space between child type column and header right edge
header_w = label_w + 1 + header_name_w + 2 + col_size_w + 2 + col_type_w
if smart_col_w:
    header_w += 5 + sum(smart_col_w) + 3 * (len(smart_col_w) - 1)

child_fixed_w = (label_w + 4) + child_name_w + 2 + col_size_w + 2 + col_type_w + 2 + 5
bar_w = max(10, header_w - child_fixed_w)


# ── Render ────────────────────────────────────────────────────────────────────

def print_header(label, name, size_s, type_s, smart_fields=None):
    line = C.w(C.BBLUE, f"{label:<{label_w}}") if label else indent
    line += " "
    line += C.w(C.BOLD, f"{name:<{header_name_w}}") + "  "
    line += C.w(C.BOLD, f"{size_s:>{col_size_w}}")
    if type_s:
        line += "  " + C.w(C.CYAN, f"{type_s:<{col_type_w}}")
    if smart_fields:
        colored = []
        for i, (plain, ansi) in enumerate(smart_fields):
            w = smart_col_w[i]
            colored.append(f"{' ' * (w - len(plain))}{ansi}")
        line += C.w(C.DIM, "  \u00b7  ") + (C.w(C.DIM, " \u00b7 ")).join(colored)
    print(line)

def print_child(tree, name, size_s, type_s, pct):
    row = f"{indent} {C.w(C.DIM, tree)} "
    row += f"{name:<{child_name_w}}  "
    row += f"{size_s:>{col_size_w}}  "
    row += C.w(C.CYAN, f"{type_s:<{col_type_w}}")
    if pct is not None:
        row += "  " + C.bar(pct, bar_w) + " " + C.pct(pct)
    print(row)

# Disks
for disk in disks:
    print_header(
        f"Disk ({disk['name']}):", disk["model"], disk["size"], disk["dtype"],
        smart_parts.get(disk["name"]))

    items = disk["mounted"]
    has_foot = disk["unmounted"] > 0
    for j, ch in enumerate(items):
        is_last = (j == len(items) - 1) and not has_foot
        tree = "\u2514\u2500" if is_last else "\u251c\u2500"
        print_child(tree, ch["mp"], ch["size"], ch["fs"], ch["pct"])

    if has_foot:
        n = disk["unmounted"]
        s = "s" if n != 1 else ""
        print(f"{indent} {C.w(C.DIM, chr(0x2514)+chr(0x2500))} "
              f"{C.w(C.DIM, f'{n} partition{s} (unmounted)')}")

# Network
first_net = True
for server, mounts in net_servers.items():
    total_s = human_size(sum(m["total"] for m in mounts))
    label = "Network:" if first_net else ""
    first_net = False
    print_header(label, server, total_s, "")

    for j, m in enumerate(mounts):
        is_last = (j == len(mounts) - 1)
        tree = "\u2514\u2500" if is_last else "\u251c\u2500"
        name_str = f"{m['share']} \u2192 {m['mp']}"
        print_child(tree, name_str, human_size(m["total"]), m["fs"].upper(), m["pct"])

# Notes
if not has_smartctl:
    print(C.w(C.DIM, "\n[SMART: install smartmontools for disk health data]"))
elif os.geteuid() != 0:
    print(C.w(C.DIM, "\n[SMART: run with sudo for disk health data]"))
