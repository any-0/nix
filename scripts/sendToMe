#!/usr/bin/env bash
set -euo pipefail

API_URL="https://mail-api.any-0.com/send"
API_KEY_FILE="${HOME}/nix/secrets/sendtome_key"
DEFAULT_TO="julianorlich1@gmail.com"

die() {
    echo "Error: $*" >&2
    exit 1
}

usage() {
    echo "Usage: sendToMe <file|dir> [--mail=<email>]" >&2
    exit 1
}

[[ $# -lt 1 ]] && usage

TARGET="$1"
TO="$DEFAULT_TO"
SUBJECT=""

for arg in "${@:2}"; do
    case "$arg" in
        --mail=*)    TO="${arg#--mail=}" ;;
        --subject=*) SUBJECT="${arg#--subject=}" ;;
        *) die "Unknown argument: $arg" ;;
    esac
done

[[ ! -e "$TARGET" ]] && die "'$TARGET' not found"
[[ ! -f "$API_KEY_FILE" ]] && die "API key not found at $API_KEY_FILE"

umask 077
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/sendtome.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT

API_KEY="$(cat "$API_KEY_FILE")"
HEADER_FILE="$TMP_DIR/headers"
printf 'X-API-Key: %s\n' "$API_KEY" > "$HEADER_FILE"
unset API_KEY

FILENAME="$(basename "$TARGET")"
UPLOAD_PATH="$TARGET"

if [[ -d "$TARGET" ]]; then
    ARCHIVE="$TMP_DIR/${FILENAME}.zip"
    echo "Zipping '$FILENAME'..."
    TARGET_DIR="$(cd "$(dirname "$TARGET")" && pwd -P)"
    (cd "$TARGET_DIR" && zip -qr "$ARCHIVE" "./$FILENAME")
    FILENAME="${FILENAME}.zip"
    UPLOAD_PATH="$ARCHIVE"
fi

echo "Sending '$FILENAME' to $TO..."

RESP_FILE="$TMP_DIR/response"
curl_args=(
    --silent
    --show-error
    --write-out "%{http_code}"
    -o "$RESP_FILE"
    --header "@$HEADER_FILE"
    --form "file=@${UPLOAD_PATH};filename=${FILENAME}"
    --form "to=${TO}"
)
if [[ -n "$SUBJECT" ]]; then
    curl_args+=(--form "subject=${SUBJECT}")
fi

HTTP_STATUS=$(curl "${curl_args[@]}" "$API_URL")

BODY="$(cat "$RESP_FILE")"

if [[ "$HTTP_STATUS" =~ ^2 ]]; then
    echo "Sent."
else
    die "API returned HTTP $HTTP_STATUS: $BODY"
fi
