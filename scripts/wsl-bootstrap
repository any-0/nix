#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
PROFILE="${1:-julian-wsl}"
BACKUP_EXT="${HM_BACKUP_EXT:-hm-bak}"
EXPERIMENTAL_FEATURES_LINE="experimental-features = nix-command flakes"

if ! command -v nix >/dev/null 2>&1; then
  echo "nix not found in PATH."
  echo "Install Nix first, then re-run this script."
  echo "Example:"
  echo "  sh <(curl -L https://nixos.org/nix/install) --daemon"
  exit 1
fi

if [[ -z "${WSL_DISTRO_NAME:-}" ]] && ! grep -qi microsoft /proc/version 2>/dev/null; then
  echo "Warning: this does not look like WSL."
  echo "Continuing anyway."
fi

if [[ "$(id -un)" != "julian" ]]; then
  echo "Warning: current user is '$(id -un)', but flake profile is configured for user 'julian'."
  echo "If switch fails, update username/homeDirectory in flake.nix."
fi

NIX_CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nix"
NIX_CONF_FILE="${NIX_CONF_DIR}/nix.conf"
mkdir -p "${NIX_CONF_DIR}"
if [[ ! -f "${NIX_CONF_FILE}" ]] || \
  ! grep -Eq '^[[:space:]]*experimental-features[[:space:]]*=.*(nix-command.*flakes|flakes.*nix-command)' "${NIX_CONF_FILE}"; then
  printf '%s\n' "${EXPERIMENTAL_FEATURES_LINE}" >> "${NIX_CONF_FILE}"
fi

if [[ -n "${NIX_CONFIG:-}" ]]; then
  export NIX_CONFIG="${NIX_CONFIG}"$'\n'"${EXPERIMENTAL_FEATURES_LINE}"
else
  export NIX_CONFIG="${EXPERIMENTAL_FEATURES_LINE}"
fi

echo "Applying Home Manager profile '${PROFILE}' from '${REPO_DIR}'..."
nix --extra-experimental-features "nix-command flakes" \
  run github:nix-community/home-manager -- \
  switch -b "${BACKUP_EXT}" --flake "${REPO_DIR}#${PROFILE}"

echo "Done."
