#!/usr/bin/env bash
set -euo pipefail

# Refresh the GPG agent's TTY so pinentry-tty can prompt here
export GPG_TTY=$(tty)
gpg-connect-agent updatestartuptty /bye > /dev/null

# Decrypt one entry to cache the passphrase in the GPG agent
if ! entries_output=$(gopass ls --flat); then
  echo "gopass is not initialized on this machine. Run 'gopass init' first." >&2
  exit 1
fi

entries=()
if [[ -n ${entries_output} ]]; then
  mapfile -t entries <<< "${entries_output}"
fi

if [[ ${#entries[@]} -eq 0 ]]; then
  echo "gopass is initialized but contains no entries to unlock." >&2
  exit 1
fi

gopass show "${entries[0]}" > /dev/null
echo "Gopass unlocked."
