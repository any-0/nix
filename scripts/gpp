#!/usr/bin/env bash
set -euo pipefail

# Copy gopass password to clipboard
# Usage: gpp <entry>
# Supports tab completion via: complete -o default -C 'gopass ls --flat' gpp

if [[ $# -lt 1 ]]; then
  echo "usage: gpp <entry>" >&2
  exit 1
fi

export GPG_TTY=$(tty)
gpg-connect-agent updatestartuptty /bye > /dev/null

gopass show -c "$1"
