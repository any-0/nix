#!/usr/bin/env bash
set -euo pipefail

# Copy gopass username to clipboard
# Usage: gpu <entry>
# Supports tab completion via: complete -o default -C 'gopass ls --flat' gpu

if [[ $# -lt 1 ]]; then
  echo "usage: gpu <entry>" >&2
  exit 1
fi

export GPG_TTY=$(tty)
gpg-connect-agent updatestartuptty /bye > /dev/null

gopass show -c "$1" username
