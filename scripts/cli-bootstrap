#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
BACKUP_EXT="${HM_BACKUP_EXT:-hm-bak}"
EXPERIMENTAL_FEATURES_LINE="experimental-features = nix-command flakes"
platform="$(uname -s)"

if [[ $# -ge 1 ]]; then
  PROFILE="$1"
else
  case "$platform" in
    Darwin)
      PROFILE="mac"
      ;;
    Linux)
      PROFILE="cli"
      ;;
    *)
      echo "unsupported platform: $platform" >&2
      exit 1
      ;;
  esac
fi

if ! command -v nix >/dev/null 2>&1; then
  echo "nix not found in PATH. Installing Nix..."
  if ! command -v curl >/dev/null 2>&1; then
    echo "curl is required to install Nix. Install curl, then re-run this script."
    exit 1
  fi
  sh <(curl -L https://nixos.org/nix/install) --daemon
  if [[ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  fi
  if ! command -v nix >/dev/null 2>&1; then
    echo "Nix installation finished, but nix is still not on PATH."
    echo "Open a new shell and re-run this script."
    exit 1
  fi
fi

if [[ "$platform" == "Linux" ]] && [[ -z "${WSL_DISTRO_NAME:-}" ]] && ! grep -qi microsoft /proc/version 2>/dev/null; then
  echo "Warning: CLI environment marker was not detected."
  echo "Continuing anyway."
fi

NIX_CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nix"
NIX_CONF_FILE="${NIX_CONF_DIR}/nix.conf"
mkdir -p "${NIX_CONF_DIR}"
if [[ ! -f "${NIX_CONF_FILE}" ]] || \
  ! grep -Eq '^[[:space:]]*experimental-features[[:space:]]*=.*(nix-command.*flakes|flakes.*nix-command)' "${NIX_CONF_FILE}"; then
  printf '%s\n' "${EXPERIMENTAL_FEATURES_LINE}" >> "${NIX_CONF_FILE}"
fi

if [[ -n "${NIX_CONFIG:-}" ]]; then
  export NIX_CONFIG="${NIX_CONFIG}"$'\n'"${EXPERIMENTAL_FEATURES_LINE}"
else
  export NIX_CONFIG="${EXPERIMENTAL_FEATURES_LINE}"
fi

echo "Applying Home Manager profile '${PROFILE}' from '${REPO_DIR}'..."
nix --extra-experimental-features "nix-command flakes" \
  run github:nix-community/home-manager -- \
  --impure switch -b "${BACKUP_EXT}" --flake "path:${REPO_DIR}#${PROFILE}"

echo "Done."
