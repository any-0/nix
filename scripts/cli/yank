#!/usr/bin/env bash
set -euo pipefail

if [[ -t 0 ]]; then
  echo "yank: expected input on stdin" >&2
  echo "usage: <command> | yank" >&2
  exit 1
fi

tmp="$(mktemp)" || {
  echo "yank: failed to create temp file" >&2
  exit 1
}

cleanup() {
  rm -f "$tmp"
}
trap cleanup EXIT

cat >"$tmp"

if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
  wl-copy <"$tmp"
  exit 0
fi

if command -v pbcopy >/dev/null 2>&1; then
  pbcopy <"$tmp"
  exit 0
fi

if [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null 2>&1; then
  xclip -selection clipboard <"$tmp"
  exit 0
fi

if command -v clip.exe >/dev/null 2>&1; then
  clip.exe <"$tmp"
  exit 0
fi

if [[ -n "${SSH_TTY:-}" ]]; then
  printf '\033]52;c;%s\a' "$(base64 --wrap=0 <"$tmp")" >/dev/tty
  exit 0
fi

echo "yank: no usable clipboard found (tried Wayland, macOS, X11, WSL, and SSH terminals)" >&2
exit 127
