#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: template <name>" >&2
  exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"
REPO_URL="https://g.any-0.com/nix.git"
TEMPLATE_NAME="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
TEMPLATE_DATE="$(date +%Y-%m-%d)"

nix flake init -t "path:${REPO_DIR}/templates#${TEMPLATE_NAME}"

cp "${REPO_DIR}/templates/dev-readme.md" .dev/README.md
printf '\nGenerated from %s, template `%s`, %s.\n' \
  "$REPO_URL" "$TEMPLATE_NAME" "$TEMPLATE_DATE" >> .dev/README.md

direnv allow
