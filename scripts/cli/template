#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: template <name>" >&2
  exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"
TEMPLATE_NAME="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
TEMPLATE_REV="$(git -C "$REPO_DIR" rev-parse HEAD)"

nix flake init -t "path:${REPO_DIR}/templates#${TEMPLATE_NAME}"

TMP_FILE="$(mktemp)"
{
  printf '# template: %s\n' "$TEMPLATE_NAME"
  printf '# template-rev: %s\n' "$TEMPLATE_REV"
  cat .dev/flake.nix
} > "$TMP_FILE"
mv "$TMP_FILE" .dev/flake.nix

direnv allow
