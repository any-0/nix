#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${RUN_CMD:-}" ]]; then
  echo "RUN_CMD is not set. Are you in a project directory with an .envrc?" >&2
  exit 1
fi

if [[ -z "${DIRENV_DIR:-}" ]]; then
  echo "DIRENV_DIR is not set. Are you in a direnv-managed directory?" >&2
  exit 1
fi

direnv_root="${DIRENV_DIR#-}"
cd "$direnv_root"

exec bash -c "$RUN_CMD" bash "$@"
