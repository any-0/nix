#!/usr/bin/env bash
set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
theme_root="$config_dir/themes"

current_theme() {
  basename -- "$(readlink -- "$config_dir/current")"
}

list_themes() {
  find -L "$theme_root" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
}

refresh_clients() {
  local codex_theme_dir="$HOME/.codex/themes"
  local claude_theme_dir="$HOME/.claude/themes"
  local codex_next="$codex_theme_dir/.current.tmTheme.$$"
  local claude_next="$claude_theme_dir/.current.json.$$"

  mkdir -p "$codex_theme_dir" "$claude_theme_dir"
  cp "$config_dir/current/codex.tmTheme" "$codex_next"
  cp "$config_dir/current/claude.json" "$claude_next"
  mv -f "$codex_next" "$codex_theme_dir/current.tmTheme"
  mv -f "$claude_next" "$claude_theme_dir/current.json"
  # kitty is not managed by this flake on every host, so reload it only where it
  # is actually installed, and never let a client that refuses to reload fail a
  # switch that has already happened.
  if command -v kitty >/dev/null 2>&1 && command -v pgrep >/dev/null 2>&1; then
    while IFS= read -r kitty_pid; do
      kitty_socket="/tmp/kitty-${USER}-${kitty_pid}"
      [[ -S "$kitty_socket" ]] || continue
      kitty @ --to "unix:$kitty_socket" set-colors --all --configured \
        "$config_dir/current/kitty.conf" || true
    done < <(pgrep -x kitty)
  fi

  mux set-theme "$config_dir/current/mux.toml" 2>/dev/null || true
}

activate_theme() {
  local name="$1"
  local theme_dir="$theme_root/$name"
  local next_link="$config_dir/.current.$$"

  [[ "$name" =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] || {
    printf 'invalid theme name: %s\n' "$name" >&2
    exit 2
  }
  [[ -d "$theme_dir" ]] || {
    printf 'unknown theme: %s\n' "$name" >&2
    exit 2
  }

  mkdir -p "$config_dir"
  trap 'rm -f "$next_link"' EXIT
  ln -s "$theme_dir" "$next_link"
  # mv -T is GNU-only; the nix wrapper guarantees coreutils on PATH.
  mv -Tf "$next_link" "$config_dir/current"
  trap - EXIT

  refresh_clients
  printf '%s\n' "$name"
}

case "${1:-current}" in
  current)
    current_theme
    ;;
  list)
    list_themes
    ;;
  next)
    mapfile -t themes < <(list_themes)
    current="$(current_theme)"
    for index in "${!themes[@]}"; do
      if [[ "${themes[$index]}" == "$current" ]]; then
        activate_theme "${themes[$(((index + 1) % ${#themes[@]}))]}"
        exit
      fi
    done
    printf 'active theme is not installed: %s\n' "$current" >&2
    exit 2
    ;;
  -h|--help)
    printf 'usage: theme [current|list|next|NAME]\n'
    ;;
  *)
    activate_theme "$1"
    ;;
esac
