#!/usr/bin/env bash
set -euo pipefail

dest="$PWD"
base="${GET_BASE:-$HOME}"

# get <path>... form: copy passed paths into current dir
if [[ $# -ge 1 ]]; then
  rsync -av --progress -- "$@" "$dest"/
  exit 0
fi

# get form: interactive pick from base, copy selections into current dir
mapfile -d '' -t rel < <(
  cd "$base" && fd -0 -t f -t d . | fzf --read0 --print0 -m
) || exit 0

((${#rel[@]})) || exit 0

abs=()
for p in "${rel[@]}"; do
  abs+=("$base/$p")
done

rsync -av --progress -- "${abs[@]}" "$dest"/
